# GEMINI_API_KEY: Optional in AI Studio environment (TOOLSEAL security decisions are 100% deterministic)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# TOOLSEAL SQLite Database Path (defaults to ./data/toolseal.db)
TOOLSEAL_DB_PATH="./data/toolseal.db"

# Bifrost Gateway Integration (optional live gateway URL; defaults to standalone DEMO MODE)
BIFROST_GATEWAY_URL="http://localhost:8080"
# Shared HMAC-SHA256 secret for verifying Bifrost PreMCPHook/PostMCPHook webhooks (backend-only, never exposed to UI)
BIFROST_SHARED_SECRET=""
BIFROST_SIGNATURE_TTL_SECONDS="300"

# Authentication & Session Settings (optional overrides for seeded RBAC accounts)
TOOLSEAL_SESSION_TTL_HOURS="24"
TOOLSEAL_ADMIN_PASSWORD=""
TOOLSEAL_ANALYST_PASSWORD=""
TOOLSEAL_VIEWER_PASSWORD=""

